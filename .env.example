JWT_ACCESS_SECRET=change_me_access

# Audience claim embedded in every JWT — consuming apps must verify this value
JWT_AUDIENCE=myapp

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=https://yourapp.com

# Token TTLs (optional, defaults shown)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# SMTP — required for email verification and password reset
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=change_me_smtp
SMTP_FROM=no-reply@example.com

# Base URL used to build links in emails (no trailing slash)
APP_URL=https://yourapp.com